CREATE TABLE IF NOT EXISTS aluno(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  cdm TEXT NOT NULL UNIQUE,
  nome TEXT NOT NULL,
  cpf TEXT NOT NULL UNIQUE,
  login TEXT NOT NULL,
  cidade TEXT NOT NULL,
  telefone TEXT NOT NULL,
  cep TEXT NOT NULL
);

