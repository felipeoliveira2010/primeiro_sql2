CREATE TABLE IF NOT EXISTS treinador(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  cdedf TEXT NOT NULL UNIQUE,
  nome TEXT NOT NULL,
  cpf TEXT NOT NULL UNIQUE,
  login TEXT NOT NULL,
  cidade TEXT NOT NULL,
  telefone TEXT NOT NULL,
