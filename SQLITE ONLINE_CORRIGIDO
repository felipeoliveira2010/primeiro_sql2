CREATE TABLE IF NOT EXISTS modalidade(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  esporte TEXT NOT NULL UNIQUE,
  turno TEXT NOT NULL UNIQUE,
  turma TEXT NOT NULL,
  agenda TEXT NOT NULL UNIQUE
);

